{
  "name": "griffpatch-studio-staging",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "observability": {"enabled": false},
  "routes": [
    {
      "pattern": "studio.griffpatch.academy",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../../build",
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
